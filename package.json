{
  "name": "deploy-crab",
  "version": "0.0.1",
  "author": "lixinqiany <yulixinqian805@163.com>",
  "private": true,
  "scripts": {
    "dev:cli": "turbo watch dev --filter=@deploy-crab/cli --ui=tui",
    "build:cli": "turbo run build --filter=@deploy-crab/cli",
    "start:cli": "turbo run start --filter=@deploy-crab/cli --ui=tui",
    "dev:server": "turbo watch dev --filter=@deploy-crab/server --ui=tui",
    "build:server": "turbo run build --filter=@deploy-crab/server",
    "start:server": "turbo run start --filter=@deploy-crab/server",
    "dev:web": "turbo watch dev --filter=@deploy-crab/web --ui=tui",
    "build:web": "turbo run build --filter=@deploy-crab/web",
    "start:web": "turbo run start --filter=@deploy-crab/web"
  },
  "devDependencies": {
    "@turbo/gen": "^2.11.10",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "turbo": "^2.11.10"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
